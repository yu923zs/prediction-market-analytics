# ---- LLM analyst (any OpenAI-compatible endpoint; defaults to DeepSeek) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ---- Kalshi (optional) ----
# Kalshi's REST API requires request signing. Without these two variables the
# pipeline skips Kalshi and runs on Polymarket only.
# https://docs.kalshi.com/getting_started/api_keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ---- Network ----
# If the platforms are not directly reachable from your network, set a proxy.
# HTTPS_PROXY=http://127.0.0.1:7897
